NODE_ENV=production
PORT=5000

DATABASE_NAME=acadify_database
DATABASE_USER=root
DATABASE_PASSWORD=your-db-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

JWT_SECRET=change-this-to-a-long-random-secret
JWT_ACCESS_EXPIRY=7d
JWT_REFRESH_EXPIRY=7d
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_OTP_COOLDOWN_SECONDS=60

CORS_ORIGIN=https://acadify.magadverse.com

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_WEBHOOK_URL=https://api.acadify.magadverse.com/api/livekit/webhook
# Optional: custom egress recorder template (self-hosted LiveKit only)
# LIVEKIT_EGRESS_TEMPLATE_URL=https://recorder.livekit.io

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-key
BLOB_CONTAINER_NAME=lms-data

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Acadify <noreply@yourdomain.com>
ADMIN_EMAIL=admin@yourdomain.com
APP_URL=https://acadify.magadverse.com
ACADEMIC_DEFAULT_PASSWORD=change-this-default-password
